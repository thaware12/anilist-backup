"193294":{"countryOfOrigin":"JP","coverImage":{"color":"#e45da1","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx193294-cWRDRpwqGYDA.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx193294-cWRDRpwqGYDA.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx193294-cWRDRpwqGYDA.jpg"},"description":"The story centers on a young man named Giuseppe, who is called \"Toristukare Otoko\" by the townspeople because once he gets absorbed in something, he cannot look at anything else. One day, he falls in love at first sight with a girl selling balloons named Pechka. He goes crazy and tries to get closer to Pechka, but she has a sadness in her heart and... For the sake of his beloved Pechka, Giuseppe and his partner, the mouse Cielo, secretly solve her worries by using the many tricks he has been obsessed with.<br><br>\n\n(Source: Crunchyroll News, edited)","endDate":{"day":7,"month":11,"year":2025},"episodes":1,"favourites":3,"format":"MOVIE","genres":["Music"],"hashtag":"#映画トリツカレ男","id":193294,"idMal":61736,"isAdult":false,"isLicensed":true,"meanScore":69,"popularity":881,"season":"FALL","seasonYear":2025,"source":"OTHER","startDate":{"day":7,"month":11,"year":2025},"status":"FINISHED","studios":[{"id":247,"name":"Shin-Ei Animation"}],"synonyms":["The Obsessed"],"tags":[{"id":1219,"isMediaSpoiler":false,"name":"Disability","rank":79},{"id":265,"isMediaSpoiler":false,"name":"Musical Theater","rank":79},{"id":1589,"isMediaSpoiler":false,"name":"Criminal Organization","rank":60}],"title":{"native":"トリツカレ男","romaji":"Toritsukare Otoko"},"trailer":{"id":"Q7T1jmDMMVQ","site":"youtube"},"type":"ANIME","updatedAt":1793093372},
