"193923":{"averageScore":59,"countryOfOrigin":"JP","coverImage":{"color":"#f1a143","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx193923-BJPyMB55Q4WC.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx193923-BJPyMB55Q4WC.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx193923-BJPyMB55Q4WC.jpg"},"description":"Descended from a long line of book collectors, high school student Mifuyu is surrounded by books in every aspect of her life. Her great-grandfather established the famous Mikura Hall, a library in the heart of town, and even the townspeople are all avid readers. There’s just one problem—Mifuyu hates books! But when a thief in Mikura Hall triggers an ancient curse, she’s left with no choice but to reclaim the stolen books herself…by entering the very stories she despises! With the help of the mysterious Mashiro, will she be able to restore her great-grandfather’s collection and save her town from a magical doom?\n<br><br>\n(Source: Yen Press)","duration":85,"endDate":{"day":26,"month":12,"year":2025},"episodes":1,"favourites":8,"format":"MOVIE","genres":["Adventure","Fantasy","Mystery"],"hashtag":"#この本を盗む者は","id":193923,"idMal":61770,"isAdult":false,"isLicensed":true,"meanScore":66,"popularity":2670,"season":"FALL","seasonYear":2025,"source":"OTHER","startDate":{"day":26,"month":12,"year":2025},"status":"FINISHED","studios":[{"id":7665,"name":"Kagome Company"}],"synonyms":["Whoever Steals This Book"],"tags":[{"id":98,"isMediaSpoiler":false,"name":"Female Protagonist","rank":100},{"id":86,"isMediaSpoiler":false,"name":"Primarily Female Cast","rank":79},{"id":244,"isMediaSpoiler":false,"name":"Isekai","rank":20},{"id":1304,"isMediaSpoiler":true,"name":"Anthropomorphism","rank":20}],"title":{"native":"この本を盗む者は","romaji":"Kono Hon wo Nusumu Mono wa"},"trailer":{"id":"sgxNwKuNIWk","site":"youtube"},"type":"ANIME","updatedAt":1793266126},
