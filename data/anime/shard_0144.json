"144509":{"averageScore":67,"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/144509-lcwAmLsTLPhR.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e4ae5d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx144509-ripxUU95hVyj.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx144509-ripxUU95hVyj.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx144509-ripxUU95hVyj.jpg"},"description":"Café “Kuronekotei” boasts an unusual roster of employees. A group of automata, or autonomous mechanical dolls, serve their patrons with a smile, but they weren’t always so suited to domestic life. Just a few years prior, automata served as weapons in the great war, fulfilling the bloody purpose for which they were created. Now that the war has ended, these machines with human hearts search for their place in an unfamiliar, peaceful world — and their search begins at the Kuronekotei café. <br>\n<br>\n(Source: Sentai Filmworks)<br>\n<br>\n<i>Note: Prima Doll was streamed 5 days in advance of the TV broadcast on ABEMA beginning July 3, 2022. Regular broadcasting began on July 9, 2022.</i>","duration":24,"endDate":{"day":24,"month":9,"year":2022},"episodes":12,"favourites":225,"format":"TV","genres":["Drama","Sci-Fi","Slice of Life"],"hashtag":"#プリマドール #PrimaDoll","id":144509,"idMal":50917,"isAdult":false,"isLicensed":true,"meanScore":67,"popularity":15263,"season":"SUMMER","seasonYear":2022,"source":"OTHER","startDate":{"day":9,"month":7,"year":2022},"status":"FINISHED","studios":[{"id":6180,"name":"Bibury Animation Studios"}],"tags":[{"id":85,"isMediaSpoiler":true,"name":"Tragedy","rank":90},{"id":175,"isMediaSpoiler":false,"name":"Robots","rank":88},{"id":98,"isMediaSpoiler":false,"name":"Female Protagonist","rank":85},{"id":240,"isMediaSpoiler":true,"name":"Amnesia","rank":80},{"id":517,"isMediaSpoiler":false,"name":"Artificial Intelligence","rank":79},{"id":86,"isMediaSpoiler":