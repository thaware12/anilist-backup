"197178":{"averageScore":77,"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/197178-kVx0Zt3P0MvD.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e45d86","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx197178-Ui8PY9HQbNgu.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx197178-Ui8PY9HQbNgu.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx197178-Ui8PY9HQbNgu.jpg"},"description":"After buying a pair of shoes that end up hurting her feet, Nami returns to the shop feeling dissatisfied.\nThere, she meets Lebno, the designer, who tells her, “I’ll make you a brand-new pair from scratch—but only if you’ll be my model.”\nThe shoes are crafted by the artisan Miucha, leading to an unexpected and stylish encounter.\n<br><br>\n(Source: Toei Animation)\n<br><br>\n<i>Note: Adaptation of the \"episode : NAMI\" chapter from the \"ONE PIECE novel HEROINES\" light novel.</i>","duration":23,"endDate":{"day":5,"month":7,"year":2026},"episodes":1,"favourites":242,"format":"SPECIAL","genres":["Action","Adventure","Drama","Fantasy"],"hashtag":"#OP_HEROINES #ONEPIECEHEROINES","id":197178,"idMal":62233,"isAdult":false,"isLicensed":true,"meanScore":78,"popularity":16718,"season":"SUMMER","seasonYear":2026,"source":"LIGHT_NOVEL","startDate":{"day":5,"month":7,"year":2026},"status":"FINISHED","studios":[{"id":18,"name":"Toei Animation"}],"synonyms":["ONE PIECE HEROINES episode: NAMI"],"tags":[{"id":86,"isMediaSpoiler":false,"name":"Primarily Female Cast","rank":100},{"id":27,"isMediaSpoiler":false,"name":"Josei","rank":100},{"id":98,"isMediaSpoiler":false,"name":"Female Protagonist","rank":92},{"id":201,"isMediaSpoiler":false,"name":"Pirates","rank":82},{"id":410,"isMediaSpoiler":false,"name":"Fashion","rank":81},{"id":631,"isMediaSpoiler":false,"name":"Feet","rank":79},{"id":648,"isMediaSpoiler":false,"name":"Crime","rank":70},{"id":109,"isMediaSpoiler":false,"name":"Primarily Ad