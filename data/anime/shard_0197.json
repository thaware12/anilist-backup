"197731":{"averageScore":63,"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/197731-VeT1HuLHoRGl.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e4a15d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx197731-6E0qjPFaNjC6.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx197731-6E0qjPFaNjC6.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx197731-6E0qjPFaNjC6.jpg"},"description":"In a society where torture is legal—and big business—Spirytus dominates the industry with skill, style, and surprisingly cheerful teamwork. Part-timers Cero, Shiu, Mikke, and Hugh tackle “client sessions,” office shenanigans, and even the occasional in-house assassin…all with a smile! Life at Spirytus proves that even in a world of pain, work can still be surprisingly fun!\n<br><br>\n(Source: Crunchyroll)","duration":24,"endDate":{"day":23,"month":3,"year":2026},"episodes":12,"favourites":152,"format":"TV","genres":["Comedy","Slice of Life"],"hashtag":"#拷問バイトくんの日常","id":197731,"idMal":61886,"isAdult":false,"isLicensed":true,"meanScore":63,"popularity":12013,"season":"WINTER","seasonYear":2026,"source":"MANGA","startDate":{"day":5,"month":1,"year":2026},"status":"FINISHED","studios":[{"id":51,"name":"diomedéa"}],"synonyms":["ชีวิตประจำวันของพนักงานพาร์ตไทม์รับจ้างทรมาน"],"tags":[{"id":1063,"isMediaSpoiler":false,"name":"Cute Boys Doing Cute Things","rank":88},{"id":1121,"isMediaSpoiler":false,"name":"Torture","rank":87},{"id":88,"isMediaSpoiler":false,"name":"Primarily Male Cast","rank":84},{"id":82,"isMediaSpoiler":false,"name":"Male Protagonist","rank":83},{"id":145,"isMediaSpoiler":false,"name":"Work","rank":77},{"id":109,"isMediaSpoiler":false,"name":"Primarily Adult Cast","rank":73},{"id":83,"isMediaSpoiler":false,"name":"Slapstick","rank":60},{"id":81,"isMediaSpoiler":false,"name":"Iyashikei","rank":60},{"id":483,"isMediaSpoiler":false,"name":"LGBTQ+ Themes","rank":56},{"id