"197474":{"averageScore":88,"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/197474-dcJmLSLc3g10.jpg","countryOfOrigin":"JP","coverImage":{"color":"#f1781a","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx197474-jTeY1G9gtD8i.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx197474-jTeY1G9gtD8i.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx197474-jTeY1G9gtD8i.jpg"},"description":"Movie remake of the Yoshiwara Enjou arc.\n<br><br>\n\nUpon meeting a young boy named Haruta who makes a living as a pickpocket, Gintoki discovers that he is pickpocketing out of a desire to meet his long-lost mother, Hiwa, Yoshiwara's number one courtesan. Gintoki and his friends venture to Yoshiwara to fulfill Haruta's wish, but standing in their way is Housen, the Night King who rules Yoshiwara.\n<br><br>\n<i>Note: This anime was announced at the \"Gintama Multiverse Festival,\" an event held on August 16th, as part of the \"Gintama 20th Anniversary Project.\" This movie features volumes 25 and 26 of the manga, and the TV anime series spans eight episodes, from episodes 139 to 146.</i>","duration":124,"endDate":{"day":13,"month":2,"year":2026},"episodes":1,"favourites":180,"format":"MOVIE","genres":["Action","Comedy","Drama","Sci-Fi"],"hashtag":"#新銀魂大炎上祭 #新劇場版銀魂","id":197474,"idMal":62277,"isAdult":false,"isLicensed":true,"meanScore":89,"popularity":6973,"season":"WINTER","seasonYear":2026,"source":"MANGA","startDate":{"day":13,"month":2,"year":2026},"status":"FINISHED","studios":[{"id":6116,"name":"Bandai Namco Pictures"}],"synonyms":["New Gintama the Movie: Yoshiwara in Flames","Gintama Movie 3: Yoshiwara in Flames","Gintama: Yoshiwara em Chamas"],"tags":[{"id":593,"isMediaSpoiler":false,"name":"Oiran","rank":95},{"id":291,"isMediaSpoiler":false,"name":"Samurai","rank":82},{"id":1277,"isMediaSpoiler":false,"name":"Found Family","rank":79},{"id":85,"isMediaSpoiler":true,"name