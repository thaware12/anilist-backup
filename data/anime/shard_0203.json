"203275":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/203275-g8zkD7HCkJCn.jpg","countryOfOrigin":"JP","coverImage":{"color":"#0da1e4","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b203275-YyNHygkzIjMC.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b203275-YyNHygkzIjMC.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/b203275-YyNHygkzIjMC.jpg"},"description":"Sixth-grader Yuuma Ashihara and his twin sister, Sawa, are playing Actual Magic, a brand-new virtual reality MMORPG, when it suddenly begins fusing with the real world. Amid all the chaos and confusion, it becomes clear that death is lurking around every corner, including when Yuuma runs into his classmate Sumika. Before, she was one of the cutest girls in his class, but she’s since undergone a terrible metamorphosis—into one of the game’s horrifying monsters! From the author of Sword Art Online and Accel World comes a story beyond VR and AR, where gaming and reality are one and the same…and staying alive is just the beginning!\n<br><br>\n(Source: Yen Press)","favourites":40,"format":"TV","genres":["Action","Adventure","Fantasy"],"hashtag":"#デモクレ","id":203275,"idMal":63045,"isAdult":false,"isLicensed":true,"popularity":5907,"season":"FALL","seasonYear":2026,"source":"LIGHT_NOVEL","startDate":{"day":6,"month":11,"year":2026},"status":"NOT_YET_RELEASED","studios":[{"id":10,"name":"Production I.G"}],"synonyms":["デモクレ","DemoKure"],"tags":[{"id":308,"isMediaSpoiler":false,"name":"Video Games","rank":60},{"id":82,"isMediaSpoiler":false,"name":"Male Protagonist","rank":53},{"id":615,"isMediaSpoiler":false,"name":"Death Game","rank":50},{"id":98,"isMediaSpoiler":false,"name":"Female Protagonist","rank":50},{"id":321,"isMediaSpoiler":false,"name":"Urban Fantasy","rank":20}],"title":{"english":"Devils' Crest","native":"デモンズ・クレスト","romaji":"Demons' Crest"},"trailer":{"id":"z_aHrTag3Ig","site":"youtube"},"type