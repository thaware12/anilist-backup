"192867":{"averageScore":60,"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/192867-r3UitttEQv8C.jpg","countryOfOrigin":"JP","coverImage":{"color":"#f1d6bb","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx192867-AXAu2LP7YA7Y.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx192867-AXAu2LP7YA7Y.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx192867-AXAu2LP7YA7Y.jpg"},"description":"Akane Tsuda (28), working at a major electronics manufacturer, impulsively buys something while drunk—something that guarantees a felony just for possession!? It was Nadeshiko, an illegally manufactured adult romance android!? Akane finds herself at Nadeshiko's mercy, but despite being toyed with, she's drawn to Nadeshiko's various impressive skills...? The single office lady and the android begin their naughty cohabitation life together!!\n<br><br>\n(Source: OceanVeil)","duration":4,"endDate":{"day":28,"month":2,"year":2026},"episodes":8,"favourites":159,"format":"TV_SHORT","genres":["Comedy","Ecchi","Romance","Sci-Fi"],"hashtag":"#はにすか #はにすかアニメ","id":192867,"idMal":61694,"isAdult":true,"isLicensed":true,"meanScore":60,"popularity":15042,"season":"WINTER","seasonYear":2026,"source":"MANGA","startDate":{"day":10,"month":1,"year":2026},"status":"FINISHED","studios":[{"id":7721,"name":"Nyan Pollution-ω-"}],"synonyms":["Does it Count if You Lose Your Virginity to an Android?","はにすか","Hanisuka","Nadeshiko. Programada para amar"],"tags":[{"id":175,"isMediaSpoiler":false,"name":"Robots","rank":100},{"id":76,"isMediaSpoiler":false,"name":"Yuri","rank":98},{"id":100,"isMediaSpoiler":false,"name":"Nudity","rank":97},{"id":517,"isMediaSpoiler":false,"name":"Artificial Intelligence","rank":96},{"id":98,"isMediaSpoiler":false,"name":"Female Protagonist","rank":96},{"id":109,"isMediaSpoiler":false,"name":"Primarily Adult Cast","rank":93},{"id":137,"isMediaSpoiler":false,"name":"Large Breasts