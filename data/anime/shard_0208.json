"208055":{"averageScore":64,"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/208055-m6wYgnG375rv.jpg","countryOfOrigin":"JP","coverImage":{"color":"#ae9328","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx208055-MYa7If5ksFhp.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx208055-MYa7If5ksFhp.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx208055-MYa7If5ksFhp.jpg"},"description":"The story takes place in a world where human civilization has collapsed and fallen into ruin.<br>\n\nIn this world, there are people who live in groups and people who live individually, moving around. – a world of freedom, so to speak.<br>\n\nTwo girls, Haru and Tamo, who live in such a world, board an old train they come across by chance and travel through the decadent world day by day.<br><br>\n\n(Source: Niigata International Animation Film Festival)<br><br>\n\n<i>Notes:<br>\n- Initially pre-screened at the Niigata International Animation Film Festival on March 15, 2025, as well as at the Fantasia Film Festival on July 19, 2025.<br>\n- Selected for the Fantasia Film Festival Anime no Bento official selection highlighting indie talent, as well as winning the audience award and gold award in the Animated Short category at the Fantasia Film Festival 2025.</i>","duration":21,"endDate":{"day":19,"month":12,"year":2025},"episodes":1,"favourites":14,"format":"MOVIE","genres":["Slice of Life"],"id":208055,"idMal":62942,"isAdult":false,"isLicensed":true,"meanScore":69,"popularity":670,"season":"FALL","seasonYear":2025,"source":"ORIGINAL","startDate":{"day":19,"month":12,"year":2025},"status":"FINISHED","synonyms":["LOCA! (ロカ)"],"tags":[{"id":81,"isMediaSpoiler":false,"name":"Iyashikei","rank":79},{"id":93,"isMediaSpoiler":false,"name":"Post-Apocalyptic","rank":79},{"id":122,"isMediaSpoiler":false,"name":"Trains","rank":79},{"id":1310,"isMediaSpoiler":false,"name":"Travel","rank":79},{