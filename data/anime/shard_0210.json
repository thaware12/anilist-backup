"210234":{"averageScore":49,"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/210234-s396ooB96p0H.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e4505d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx210234-MZaMjdbBzEHz.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx210234-MZaMjdbBzEHz.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx210234-MZaMjdbBzEHz.jpg"},"description":"Rude, an E-rank adventurer. His only skill, \"Status Ailment Nullification,\" is a niche ability considered useful only for gathering medicinal herbs in miasma-choked dungeons. With virtually zero combat prowess, his fellow adventurers mock him with the nickname \"Miasma Scavenger.\" In a desperate bid to change his life, Rude ventures into a new dungeon—only to be betrayed by his party and left for dead. With his supplies gone and his life fading, he makes a forbidden choice: to consume the flesh of a monster. So begins the tale of Rude’s \"Monster Devouring\" adventure, where he gains new skills by simply consuming his foes!\n<br><br>\n(Source: Ani-One Asia)","duration":13,"endDate":{"day":19,"month":6,"year":2026},"episodes":12,"favourites":131,"format":"TV_SHORT","genres":["Action","Adventure","Fantasy"],"hashtag":"#魔物喰らいの冒険者","id":210234,"idMal":63304,"isAdult":false,"isLicensed":true,"meanScore":49,"popularity":9510,"season":"SPRING","seasonYear":2026,"source":"LIGHT_NOVEL","startDate":{"day":3,"month":4,"year":2026},"status":"FINISHED","studios":[{"id":7472,"name":"Imagica Infos"},{"id":7531,"name":"Imageworks Studio"}],"tags":[{"id":604,"isMediaSpoiler":false,"name":"Dungeon","rank":50},{"id":82,"isMediaSpoiler":false,"name":"Male Protagonist","rank":40},{"id":242,"isMediaSpoiler":false,"name":"Flash","rank":20},{"id":142,"isMediaSpoiler":false,"name":"Food","rank":20},{"id":29,"isMediaSpoiler":false,"name":"Magic","rank":20},{"id":598,"isMediaSpoiler":false,"name":"Elf"