"219189":{"countryOfOrigin":"JP","coverImage":{"color":"#1a6bf1","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx219189-0eyzbkCgMcN1.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx219189-0eyzbkCgMcN1.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx219189-0eyzbkCgMcN1.jpg"},"description":"Every family has its own \"secrets\"... Meet our protagonist, Shota Minamoto, a junior-high school student who also happens to be an orphan in a children's home. One day, he was adopted by a family living in a luxurious, Japanese-style estate. Welcomed warmly by them all, Shota started letting his guard down but this family had a \"secret\" that the world could never know.\n<br><br>\nA new work from the creator of \"The Cuckoo's Fiance\" showcasing a different kind of \"family.\" Thus begins a cozy, bloody love comedy!\n<br><br>\n(Source: K-Manga)","favourites":1,"format":"TV","hashtag":"#柊さんちの吸血事情","id":219189,"idMal":65288,"isAdult":false,"isLicensed":true,"popularity":688,"source":"MANGA","status":"NOT_YET_RELEASED","synonyms":["Hiragi-san's House of Vampires"],"tags":[{"id":74,"isMediaSpoiler":false,"name":"Vampire","rank":20},{"id":82,"isMediaSpoiler":false,"name":"Male Protagonist","rank":20},{"id":1052,"isMediaSpoiler":false,"name":"Adoption","rank":20},{"id":1382,"isMediaSpoiler":false,"name":"Orphan","rank":20}],"title":{"native":"柊さんちの吸血事情","romaji":"Hiiragi-san Chi no Kyuuketsu Jijou"},"type":"ANIME","updatedAt":1794463369},
