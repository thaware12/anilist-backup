"219798":{"countryOfOrigin":"JP","coverImage":{"color":"#f15078","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx219798-llgXPVdoqwso.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx219798-llgXPVdoqwso.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx219798-llgXPVdoqwso.jpg"},"description":"The new series from Tomoko Ninomiya, creator of Nodame Cantabile, turns its focus on the world of jewelry! Shinobu, a second-year in high school, is part of the family that runs Kurata-ya, a storied pawn shop based in a breezy central Tokyo neighborhood. She helps run the place when school isn’t calling, and she has a natural gift that aids her a great deal—the ability to see the “aura” released by gemstones! Shinobu doesn’t have a boyfriend, but she does have a fiancé handpicked for her by her grandfather—Akisada Kitagami, a man from a prestigious family who wound up being taken in by Kurata-ya at a young age. He now works as a salesman for a first-class jewelry brand, but he’s also got more than his fair share of secrets…\n<br><br>\n(Source: K MANGA)","favourites":0,"format":"TV","genres":["Drama","Mystery","Slice of Life"],"id":219798,"idMal":65412,"isAdult":false,"isLicensed":true,"popularity":0,"source":"MANGA","startDate":{"year":2027},"status":"NOT_YET_RELEASED","studios":[{"id":7,"name":"J.C.STAFF"}],"tags":[{"id":27,"isMediaSpoiler":false,"name":"Josei","rank":20}],"title":{"native":"七つ屋 志のぶの宝石匣","romaji":"Nanatsuya: Shinobu no Housekibako"},"type":"ANIME","updatedAt":1794448888}
