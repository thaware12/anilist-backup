"219265":{"countryOfOrigin":"JP","coverImage":{"color":"#e4861a","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx219265-RozW4Qj1czR8.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx219265-RozW4Qj1czR8.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx219265-RozW4Qj1czR8.jpg"},"description":"Spacious apartment in a new building, an expansive kitchen with an induction stove, a bathroom with a separated toilet, and even a washroom, all for just... 4800 yen a month?!\nBut there is a spooky reason Maison Shiba is so doggone affordable...<br><br>\nThe room high schooler Kori Momose was offered came with a room mate:\nMu-chan, a Shiba Inu who happens to be an earthbound spirit.\nWith the ultimate goal of a comfortable lifestyle with no roommates, Kori tries all kinds of strategies to unbind Mu from room 101.<br><br>\nGet ready for a heartwarming comedy at Maison Shiba,full of quirky neighbors, adorable Shiba inus, and plenty of fluffy, chaotic fun!\n<br><br>\n(Source: SHIBA INU ROOMS Official Site)","favourites":3,"format":"TV","genres":["Comedy","Slice of Life","Supernatural"],"hashtag":"#シバつき物件","id":219265,"idMal":65300,"isAdult":false,"isLicensed":true,"popularity":394,"season":"SUMMER","seasonYear":2027,"source":"MANGA","startDate":{"year":2027},"status":"NOT_YET_RELEASED","studios":[{"id":73,"name":"TMS Entertainment"}],"synonyms":["Shiba Inu Rooms"],"tags":[{"id":98,"isMediaSpoiler":false,"name":"Female Protagonist","rank":79},{"id":220,"isMediaSpoiler":false,"name":"Ghost","rank":79},{"id":1601,"isMediaSpoiler":false,"name":"Primarily Animal Cast","rank":79},{"id":433,"isMediaSpoiler":false,"name":"Animals","rank":79},{"id":56,"isMediaSpoiler":false,"name":"Shounen","rank":79},{"id":1689,"isMediaSpoiler":false,"name":"Curses","rank":79},{"id":171,"isMediaSpoiler":true,"name":"Bullying","rank":79}],"title":{"native":"シバつき物件","romaji":"Shibatsuki Bukken"},"trailer":{"id":"0wbche