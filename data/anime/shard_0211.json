"211220":{"averageScore":65,"countryOfOrigin":"CN","coverImage":{"color":"#ff43c9","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx211220-fkWS8gCM2rA5.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx211220-fkWS8gCM2rA5.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx211220-fkWS8gCM2rA5.png"},"description":"Adapted from a novel by Wen Zhou, this story follows Li Xiongmao, a human boy raised by demons who is sent by his master to leave Black-White Mountain and kill the three enemies responsible for the demons’ downfall. As he searches for the truth, he gradually unravels the mysteries behind the conflict between humans and demons, the secrets of the dynasty, and his own destiny.\n<br><br>\n(Source: iQIYI, translated)","episodes":18,"favourites":25,"format":"ONA","genres":["Adventure"],"id":211220,"idMal":63987,"isAdult":false,"isLicensed":true,"meanScore":75,"popularity":1983,"source":"OTHER","startDate":{"day":29,"month":7,"year":2026},"status":"RELEASING","studios":[{"id":6546,"name":"GARDEN"}],"tags":[{"id":15,"isMediaSpoiler":false,"name":"Demons","rank":79}],"title":{"english":"Raised by Demons: Panda Li","native":"李熊猫","romaji":"Li Xiongmao"},"trailer":{"id":"aUuiaKnLR1g","site":"youtube"},"type":"ANIME","updatedAt":1793201873},
