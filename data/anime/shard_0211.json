"211338":{"averageScore":55,"countryOfOrigin":"JP","coverImage":{"color":"#e4ae50","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx211338-If49uIjNKPgt.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx211338-If49uIjNKPgt.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx211338-If49uIjNKPgt.png"},"description":"Based on the erotic game by Resta.\n<br><br>\nIt's summer. You and your friends are on vacation, when suddenly the sea carries your boat away to an unknown island in another world. This island—Paradisiem Island—is small, with one village. According to the village chief, the island's Guardian Deity foresaw the arrival of you and your friends, and they want you to help the island return to its former glory. Without more tourists, there aren't enough people to worship the Guardian Deity, whose powers you need to return to your home world. Work together with your friends, Sahoto, Mei, and Chiyo, as well as some new friends you make on the island, to help it grow and prosper into a popular tourist destination!\n<br><br>\n(Source: Steam)","episodes":1,"favourites":29,"format":"OVA","genres":["Hentai"],"id":211338,"idMal":64095,"isAdult":true,"isLicensed":true,"meanScore":58,"popularity":632,"season":"SUMMER","seasonYear":2026,"source":"VISUAL_NOVEL","startDate":{"day":31,"month":7,"year":2026},"status":"RELEASING","studios":[{"id":6155,"name":"Collaboration Works petit"}],"synonyms":["Welcome to Paradise Island!","Harem Shima e Youkoso!"],"tags":[{"id":23,"isMediaSpoiler":false,"name":"Female Harem","rank":20}],"title":{"native":"ハーレム島へようこそ！","romaji":"Harem-tou e Youkoso!"},"type":"ANIME","updatedAt":1793178523},
